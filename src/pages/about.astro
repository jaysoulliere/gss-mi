---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About | ${SITE_TITLE}`}
			description="Learn how Global Security Solutions Michigan approaches security coverage, communication, and field support."
			image="/security-operations.svg"
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-hero narrow">
				<p class="eyebrow">About GSS Michigan</p>
				<h1>Security coverage should be professional, visible, and easy to coordinate.</h1>
				<p>
					Global Security Solutions Michigan focuses on practical site support: trained presence,
					clear post expectations, and communication that helps clients and supervisors stay aligned.
				</p>
			</section>

			<section class="split-section">
				<div>
					<h2>Built for the realities of active posts.</h2>
					<p>
						Sites change. Schedules shift. Incidents need to be documented. GSS Michigan keeps the
						work centered on dependable coverage, respectful conduct, and straightforward updates.
					</p>
				</div>
				<div class="statement-list">
					<article>
						<h3>Prepared personnel</h3>
						<p>Officers are matched to the expectations of each site and post.</p>
					</article>
					<article>
						<h3>Supervisor awareness</h3>
						<p>Coverage issues and post needs are communicated before they become larger problems.</p>
					</article>
					<article>
						<h3>Client confidence</h3>
						<p>Reports and updates are kept useful for the people responsible for the property.</p>
					</article>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
